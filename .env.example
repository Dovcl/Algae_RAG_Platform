POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=your_postgres_db_here

# 예측 구현: mock(가짜 숫자) / precomputed(연구실 CSV의 관측값과 2023년 저장 예측) / tft(실제 모델, 서버 전용)
PREDICT_BACKEND=mock

# 언어 모델: mock(정해진 틀의 답) / ollama(문서 검색 + 실제 모델)
LLM_PROVIDER=mock

# Ollama 주소 (맥 개발: 호스트의 Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=bge-m3
# 검색할 컬렉션 ID. 적재 후 주석을 풀고 정한다 (빈 값으로 두면 None이 아니라 '')
# RAG_COLLECTION=

# 생성 모델 (LLM_PROVIDER=ollama일 때)
LLM_MODEL=exaone3.5:7.8b
